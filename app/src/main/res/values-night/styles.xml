<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowAnimationStyle">@style/notAnimation</item>
        <item name="android:statusBarColor" tools:targetApi="m">@color/window_bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="m">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:navigationBarColor" tools:targetApi="o_mr1">@color/window_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>

</resources>
